# =====================================================================
# FILE MẪU cấu hình bí mật cho backend.
#
# CÁCH DÙNG:
#   1. Copy file này thành file tên ".env" (cùng thư mục, cạnh pom.xml).
#   2. Điền giá trị thật vào file .env.
#   3. Khởi động lại backend.
#
# File .env đã được .gitignore bỏ qua nên KHÔNG bị đẩy lên GitHub.
# File .env.example này KHÔNG được chứa mật khẩu thật (nó sẽ được commit).
# Dòng bắt đầu bằng # là chú thích. Không cần dấu ngoặc kép quanh giá trị.
# =====================================================================

# ----- MySQL (bỏ dấu # ở đầu dòng nếu mật khẩu MySQL của bạn khác 123456) -----
# DB_USERNAME=root
# DB_PASSWORD=123456

# ----- Gửi email thật qua Gmail -----
# true = gửi thật; false = chỉ in email ra console (log [DEV MAIL])
MAIL_ENABLED=false
# Địa chỉ Gmail dùng để gửi
MAIL_USERNAME=
# App Password 16 ký tự do Google cấp (KHÔNG phải mật khẩu đăng nhập Gmail), viết liền không dấu cách
MAIL_PASSWORD=
