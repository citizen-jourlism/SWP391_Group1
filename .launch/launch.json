{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "frontend",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev", "--prefix", "citizen_journalism/frontend"],
      "port": 5173
    },
    {
      "name": "backend",
      "runtimeExecutable": "cmd",
      "runtimeArgs": ["/c", "citizen_journalism\\mvnw.cmd", "-f", "citizen_journalism\\pom.xml", "spring-boot:run"],
      "port": 8080
    },
    {
      "name": "backend-nomail",
      "runtimeExecutable": "cmd",
      "runtimeArgs": ["/c", "citizen_journalism\\mvnw.cmd", "-f", "citizen_journalism\\pom.xml", "spring-boot:run", "-Dspring-boot.run.arguments=--app.mail.enabled=false"],
      "port": 8080
    },
    {
      "name": "backend-test",
      "runtimeExecutable": "cmd",
      "runtimeArgs": ["/c", "citizen_journalism\\mvnw.cmd", "-f", "citizen_journalism\\pom.xml", "spring-boot:run", "-Dspring-boot.run.arguments=--server.port=8081 --app.mail.enabled=false"],
      "port": 8081
    },
    {
      "name": "frontend-test",
      "runtimeExecutable": "cmd",
      "runtimeArgs": ["/c", "set API_TARGET=http://localhost:8081&& npm run dev --prefix citizen_journalism/frontend -- --port 5174 --strictPort"],
      "port": 5174
    }
  ]
}
